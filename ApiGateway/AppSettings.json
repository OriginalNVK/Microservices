{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "HKShopSuperSecretKeyForJWT2024!",
    "Issuer": "UserService",
    "Audience": "HKShopClients"
  },
  "ReverseProxy": {
    "Routes": {
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-service-profile-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/khachhang/{**catch-all}"
        }
      },
      "user-service-nhanvien-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/nhanvien/{**catch-all}"
        }
      },
      "product-service-hanghoa-route": {
        "ClusterId": "product-service-cluster",
        "Match": {
          "Path": "/api/hanghoa/{**catch-all}"
        }
      },
      "product-service-loai-route": {
        "ClusterId": "product-service-cluster",
        "Match": {
          "Path": "/api/loai/{**catch-all}"
        }
      },
      "cart-service-route": {
        "ClusterId": "cart-service-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "order-service-route": {
        "ClusterId": "order-service-cluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      },
      "invoice-service-route": {
        "ClusterId": "invoice-service-cluster",
        "Match": {
          "Path": "/api/invoice/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-service:8080/"
          }
        }
      },
      "product-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://product-service:8080/"
          }
        }
      },
      "cart-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-service:8080/"
          }
        }
      },
      "order-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-service:8080/"
          }
        }
      },
      "invoice-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://invoice-service:8080/"
          }
        }
      }
    }
  }
}
